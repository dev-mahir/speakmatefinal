# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SPEAKMATE CLIENT CONFIGURATION (VITE_*)
# Safe for browser execution. Leave empty to run with local sandbox data.
# ==============================================================================

# Supabase Project URL & Anon Key (Get from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Media & SFU Infrastructure: 'webrtc_p2p' or 'livekit'
VITE_MEDIA_PROVIDER="webrtc_p2p"
VITE_LIVEKIT_URL=""

# Timezone for daily speaking allowance reset (default: Asia/Dhaka)
VITE_APP_TIMEZONE="Asia/Dhaka"

# ==============================================================================
# SECURE SERVER-SIDE SECRETS (Supabase Edge Functions / Secret Manager ONLY)
# NEVER expose these with VITE_ prefixes in browser code!
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY="ey..."
# LIVEKIT_API_KEY="APIxxxx"
# LIVEKIT_API_SECRET="secretxxxx"
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""
# NAGAD_MERCHANT_ID=""
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASS=""

